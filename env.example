# Copy to .env and adjust. Every variable is required.

LIPI_DATABASE_URL=postgresql://lipi:lipi@localhost:5434/lipi
LIPI_STORAGE_ROOT=./data
LIPI_BASE_URL=http://localhost:8100
LIPI_SERVICE_NAME="Lipi (local)"

# Comma-separated model ids; the first is the default.
LIPI_STT_MODELS=default
# BCP 47 tags the service can transcribe, comma-separated.
LIPI_LANGUAGES=en,hi,kn,te,mr,ta
LIPI_AUDIO_FORMATS="audio/webm;codecs=opus,audio/wav,audio/ogg;codecs=opus"

LIPI_MAX_CHUNK_SECONDS=25
LIPI_MAX_SECONDS=7200
LIPI_INACTIVITY_SECONDS=300
LIPI_MAX_SOURCES_PER_SESSION=20
LIPI_MAX_AUDIO_SOURCES=3

# Used by `make test` only.
LIPI_TEST_DATABASE_URL=postgresql://lipi:lipi@localhost:5434/lipi_test
